    future_expansion_panel_height,
    future_expansion_panel_clearance
];

function component_left(component) =
    component[0] - (component[2] / 2) - component[4];
function component_right(component) =
    component[0] + (component[2] / 2) + component[4];
function component_bottom(component) =
    component[1] - (component[3] / 2) - component[4];
function component_top(component) =
    component[1] + (component[3] / 2) + component[4];

function rectangles_overlap(component_a, component_b,
    minimum_spacing = panel_component_minimum_spacing) =
    component_left(component_a) - (minimum_spacing / 2) <
        component_right(component_b) + (minimum_spacing / 2) &&
    component_right(component_a) + (minimum_spacing / 2) >
        component_left(component_b) - (minimum_spacing / 2) &&
    component_bottom(component_a) - (minimum_spacing / 2) <
        component_top(component_b) + (minimum_spacing / 2) &&
    component_top(component_a) + (minimum_spacing / 2) >
        component_bottom(component_b) - (minimum_spacing / 2);

