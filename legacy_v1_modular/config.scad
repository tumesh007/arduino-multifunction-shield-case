lid_inner_width = external_width - (wall_thickness * 2) - (lid_fit_clearance * 2);

// -----------------------------------------------------------------------------
// Configuration validation
// -----------------------------------------------------------------------------

assert(wall_thickness >= minimum_printable_wall,
    "Wall thickness is below the recommended FDM minimum.");
assert(bottom_thickness >= minimum_printable_wall,
    "Bottom thickness is below the recommended FDM minimum.");
assert(lid_thickness >= minimum_printable_wall,
    "Lid thickness is below the recommended FDM minimum.");
assert(outer_corner_radius >= wall_thickness,
    "Outer corner radius must be at least the wall thickness.");
assert(inner_corner_radius > 0 && inner_corner_radius < outer_corner_radius,
    "Calculated inner corner radius is invalid.");
assert(battery_holder_length > 0 && battery_holder_width > 0 && battery_holder_height > 0,
    "Battery holder dimensions must be positive.");
assert(battery_compartment_inner_length >= battery_holder_length + 2 * battery_holder_clearance_x &&
       battery_compartment_inner_width >= battery_holder_width + 2 * battery_holder_clearance_y &&
       battery_compartment_inner_height >= battery_holder_height + battery_holder_clearance_z,
    "Battery compartment is smaller than the configured holder and clearances.");
assert(arduino_side_clearance >= 0 && arduino_end_clearance >= 0 && arduino_top_clearance >= 0,
    "Arduino clearances must not be negative.");
assert(required_internal_height >= electronics_stack_height + arduino_top_clearance,
    "Internal height does not provide Arduino and shield clearance.");
assert(display_visible_length > 0 && display_visible_width > 0 &&
       display_window_top_left_x >= 0 && display_window_top_left_y >= 0 &&
       display_window_bottom_right_x <= arduino_feature_x_extent &&
       display_window_bottom_right_y <= arduino_feature_y_extent,
    "Display window lies outside the Arduino feature coordinate envelope.");
assert(button_plunger_diameter > 0 && button_shaft_length > 0 &&
       button_1_x >= 0 && button_1_x <= arduino_feature_x_extent &&
       button_1_y >= 0 && button_1_y <= arduino_feature_y_extent &&
       button_2_x >= 0 && button_2_x <= arduino_feature_x_extent &&
       button_2_y >= 0 && button_2_y <= arduino_feature_y_extent &&
       button_3_x >= 0 && button_3_x <= arduino_feature_x_extent &&
       button_3_y >= 0 && button_3_y <= arduino_feature_y_extent,
    "One or more button locations lie outside the Arduino feature coordinate envelope.");
assert(screw_post_outer_diameter >=
       screw_clearance_diameter + (screw_post_minimum_wall * 2),
    "Screw boss diameter is insufficient for the selected screw clearance.");
assert(external_length <= printer_build_x && external_width <= printer_build_y &&
       external_height <= printer_build_z,
    "Enclosure exceeds the configured printer build volume.");
assert(side_vent_angle <= support_free_overhang_angle &&
       arduino_rail_lead_in_angle <= support_free_overhang_angle &&
       bridge_angle <= support_free_overhang_angle,
    "One or more printable overhang or bridge assumptions exceed the configured limit.");
assert(fastener_type == "M3_socket_cap" || fastener_type == "M3_pan_head" ||
       fastener_type == "M3_button_head",
    "fastener_type must be M3_socket_cap, M3_pan_head, or M3_button_head.");
assert(!rectangles_overlap(dc_barrel_component, rocker_switch_component),
    "Panel collision: DC barrel connector conflicts with the rocker switch clearance envelope.");
assert(!rectangles_overlap(usb_opening_component, rocker_switch_component),
    "Panel collision: USB opening conflicts with the rocker switch clearance envelope.");
assert(!rectangles_overlap(usb_opening_component, dc_barrel_component),
    "Panel collision: USB opening conflicts with the DC barrel connector clearance envelope.");
assert(!rectangles_overlap(future_expansion_panel_component, rocker_switch_component),
    "Panel collision: Future expansion panel conflicts with the rocker switch clearance envelope.");
assert(!rectangles_overlap(future_expansion_panel_component, dc_barrel_component),
    "Panel collision: Future expansion panel conflicts with the DC barrel connector clearance envelope.");
assert(component_left(rocker_switch_component) >= wall_thickness &&
       component_right(rocker_switch_component) <= external_length - wall_thickness &&
       component_bottom(rocker_switch_component) >= wall_thickness &&
       component_top(rocker_switch_component) <= external_height - wall_thickness,
    "Panel edge clearance: Rocker switch opening is closer than wall_thickness to an enclosure edge.");
assert(component_left(dc_barrel_component) >= wall_thickness &&
       component_right(dc_barrel_component) <= external_length - wall_thickness &&
       component_bottom(dc_barrel_component) >= wall_thickness &&
       component_top(dc_barrel_component) <= external_height - wall_thickness,
    "Panel edge clearance: DC barrel opening is closer than wall_thickness to an enclosure edge.");
assert(component_left(usb_opening_component) >= wall_thickness &&
       component_right(usb_opening_component) <= external_length - wall_thickness &&
       component_bottom(usb_opening_component) >= wall_thickness &&
       component_top(usb_opening_component) <= external_height - wall_thickness,
    "Panel edge clearance: USB opening is closer than wall_thickness to an enclosure edge.");
assert(component_left(future_expansion_panel_component) >= wall_thickness &&
       component_right(future_expansion_panel_component) <= external_length - wall_thickness &&
       component_bottom(future_expansion_panel_component) >= wall_thickness &&
       component_top(future_expansion_panel_component) <= external_height - wall_thickness,
    "Panel edge clearance: Future expansion panel is closer than wall_thickness to an enclosure edge.");